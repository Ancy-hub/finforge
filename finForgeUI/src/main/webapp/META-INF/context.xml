<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tomcat context descriptor — binds a JNDI DataSource backed by the built-in
  Tomcat DBCP2 connection pool.

  Deploy location:
    src/main/webapp/META-INF/context.xml  → packaged into the WAR as META-INF/context.xml

  The JNDI name used by DBConnection is:
    java:comp/env/jdbc/SmartFinForge

  Tune maxTotal / maxIdle / minIdle for your production load.
  IMPORTANT: Replace the password value before deploying to production.
-->
<Context>

    <!--
      Pool sizing  : maxTotal=20 active, maxIdle=10 kept ready, minIdle=5 pre-warmed
      Wait policy  : block up to 30 s before raising an error
      Health check : validate every borrowed connection with SELECT 1
      Leak recovery: reclaim connections abandoned for > 60 s and log them
    -->
    <Resource name="jdbc/SmartFinForge"
              auth="Container"
              type="javax.sql.DataSource"
              driverClassName="com.microsoft.sqlserver.jdbc.SQLServerDriver"
              url="jdbc:sqlserver://localhost:1433;databaseName=SmartFinForge;encrypt=true;trustServerCertificate=true"
              username="sa"
              password="YourStrongPassword123!"
              maxTotal="20"
              maxIdle="10"
              minIdle="5"
              maxWaitMillis="30000"
              validationQuery="SELECT 1"
              testOnBorrow="true"
              removeAbandonedOnBorrow="true"
              removeAbandonedTimeout="60"
              logAbandoned="true"/>

</Context>
