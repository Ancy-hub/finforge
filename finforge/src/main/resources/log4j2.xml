<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log4j 2 configuration for Smart FinForge.

  Appenders:
    Console     — coloured, pattern-based output for the IDE / Tomcat catalina.out
    FileAppender — rolling file under <TOMCAT_HOME>/logs/ (or CWD when running tests)

  Log levels:
    com.finforge → DEBUG (all application classes)
    Root               → WARN  (suppress chatty 3rd-party libs)
-->
<Configuration status="WARN">

    <Appenders>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>

        <RollingFile name="FileAppender"
                     fileName="logs/smart-finforge.log"
                     filePattern="logs/smart-finforge-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
            <Policies>
                <!-- Roll over at midnight -->
                <TimeBasedTriggeringPolicy/>
                <!-- Also roll when the file reaches 10 MB -->
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <!-- Keep at most 30 archived files -->
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

    </Appenders>

    <Loggers>

        <!-- Application code: DEBUG → Console + File -->
        <Logger name="com.finforge" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <!-- Root: WARN-only → Console (avoid drowning in framework noise) -->
        <Root level="WARN">
            <AppenderRef ref="Console"/>
        </Root>

    </Loggers>

</Configuration>
